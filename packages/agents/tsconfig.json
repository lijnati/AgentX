{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@agentx/domain": ["../domain/src"],
      "@agentx/validation": ["../validation/src"],
      "@agentx/blockchain": ["../blockchain/src"]
    }
  },
  "references": [
    { "path": "../domain" },
    { "path": "../validation" },
    { "path": "../blockchain" }
  ],
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/*", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
